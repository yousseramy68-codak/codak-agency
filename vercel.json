{"$schema":"https://openapi.vercel.sh/vercel.json","version":2,"builds":[{"src":"api/index.js","use":"@vercel/node"},{"src":"site/**","use":"@vercel/static"},{"src":"css/**","use":"@vercel/static"},{"src":"js/**","use":"@vercel/static"},{"src":"public/**","use":"@vercel/static"}],"routes":[{"src":"/api/(.*)","dest":"/api/index.js"},{"src":"/(en|ar|fr|es|de)/services/?$","dest":"/$1/#services","status":302},{"src":"/(en|ar|fr|es|de)/(work|portfolio)/?$","dest":"/$1/#work","status":302},{"src":"/(en|ar|fr|es|de)/(about|team)/?$","dest":"/$1/#team","status":302},{"src":"/$","dest":"/site/en/index.html"},{"src":"/(images|videos|icons)/(.*)","dest":"/public/$1/$2"},{"src":"/(favicon.ico|manifest.webmanifest|robots.txt|sitemap.xml)","dest":"/public/$1"},{"src":"/(.*)","dest":"/site/$1/index.html"}]}
